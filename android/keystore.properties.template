# Copy to android/keystore.properties (gitignored) before a release build.
# Never commit the filled-in file: the self-updater installs APKs straight from
# GitHub releases, so the signing key is the security boundary for updates.
MYAPP_RELEASE_STORE_FILE=/absolute/path/to/ghostmesh-release.keystore
MYAPP_RELEASE_KEY_ALIAS=ghostmesh
MYAPP_RELEASE_STORE_PASSWORD=change-me
MYAPP_RELEASE_KEY_PASSWORD=change-me
