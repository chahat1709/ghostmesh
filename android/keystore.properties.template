# Copy to android/keystore.properties and fill in. That file is gitignored —
# never commit a keystore path or password.
#
# Generate a key once with:
#   keytool -genkeypair -v -storetype PKCS12 -keystore ghostmesh-release.keystore \
#     -alias ghostmesh -keyalg RSA -keysize 2048 -validity 10000
MYAPP_RELEASE_STORE_FILE=/absolute/path/to/ghostmesh-release.keystore
MYAPP_RELEASE_KEY_ALIAS=ghostmesh
MYAPP_RELEASE_STORE_PASSWORD=change-me
MYAPP_RELEASE_KEY_PASSWORD=change-me
